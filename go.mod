// tangled.org/core uses these forks for extra commit/patch metadata fields.
// Go does not inherit replace directives from dependencies, so tack must repeat
// the replacements from tangled.org/core's go.mod while we import its packages.
replace (
	github.com/bluekeyes/go-gitdiff => tangled.sh/oppi.li/go-gitdiff v0.8.2
